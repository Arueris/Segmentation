    "import numpy as np\n",
    "import pretrain_encoder\n",
    "import os\n",
    "import torch\n",
    "import dataset\n",
    "import matplotlib.pyplot as plt\n",
    "from pathlib import Path\n",
    "\n",
    "datapath = r\"F:/Python/SAM2/OCTDatasetOIMHS\"\n",
    "participants = os.listdir(Path(datapath) / \"Images\")\n",
    "print(participants)\n",
    "train_loader, _ = dataset.get_dataloader(\n",
    "    participants,\n",
    "    train_portion=0.7,\n",
    "    path=datapath,\n",
    "    batch_size=4,\n",
    "    normalize=\"zscore\",\n",
    "    augment=False\n",
    "    )\n",
    "\n",
    "images, masks = next(iter(train_loader))\n",
    "\n",
    "mask = pretrain_encoder.create_patch_mask(images, grid_size=16, mask_ratio=0.75)\n",
    "masked_images = images * (1- mask)\n",
    "\n",
    "img_nr = 3\n",
    "\n",
    "img = images[img_nr, 0].numpy()\n",
    "msk = mask[img_nr, 0].numpy()\n",
    "mimg = masked_images[img_nr, 0].numpy()\n",
    "\n",
    "fig, axs = plt.subplots(1, 3, figsize=(15, 5))\n",
    "\n",
    "axs[0].imshow(img, cmap=\"gray\")\n",
    "axs[0].set_title(\"Original Image\")\n",
    "axs[0].axis(\"off\")\n",
    "\n",
    "axs[1].imshow(msk, cmap=\"gray\")\n",
    "axs[1].set_title(\"Mask\")\n",
    "axs[1].axis(\"off\")\n",
    "\n",
    "axs[2].imshow(mimg, cmap=\"gray\")\n",
    "axs[2].set_title(\"Masked Image\")\n",
    "axs[2].axis(\"off\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
