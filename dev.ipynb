    "from pathlib import Path\n",
    "import os\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "basepath = Path(r\"datasets\\For_Bjorn\")\n",
    "\n",
    "all_elements = list(basepath.glob(\"*.npy\"))\n",
    "\n",
    "obs = \"ID032_OD\"\n",
    "\n",
    "all_obs = set(\"_\".join(x.name.split(\"_\")[:1]) for x in all_elements)\n",
    "\n",
    "for obs in all_obs:\n",
    "\n",
    "    elements_for_obs = [x for x in all_elements if obs in str(x.name)]\n",
    "    print(f\"Elements for {obs}: {[x.name for x in elements_for_obs]}\")\n",
    "    bm = np.load(elements_for_obs[0])\n",
    "    chor = np.load(elements_for_obs[1])\n",
    "    x_slice = np.load(elements_for_obs[2])\n",
    "    y_slice = np.load(elements_for_obs[3])\n",
    "\n",
    "    print(f\"bm shape: {bm.shape}, chor shape: {chor.shape}, x_slice shape: {x_slice.shape}, y_slice shape: {y_slice.shape}\")\n",
    "\n",
    "    print(f\"bm min: {bm.min()}, bm max: {bm.max()}\")\n",
    "    print(f\"chor min: {chor.min()}, chor max: {chor.max()}\")\n",
    "    print(f\"x_slice min: {x_slice.min()}, x_slice max: {x_slice.max()}\")\n",
    "    print(f\"y_slice min: {y_slice.min()}, y_slice max: {y_slice.max()}\")\n",
    "\n",
    "    idx = 512\n",
    "\n",
    "    # bm_anno = bm\n",
    "    # chor_anno = chor\n",
    "\n",
    "    fig, axs = plt.subplots(2, 2, figsize=(15, 10))\n",
    "\n",
    "    axs[0, 0].imshow(y_slice, cmap=\"gray\", aspect=\"auto\")\n",
    "    axs[0, 0].plot(np.arange(1024), bm[idx, :], color='red', label='BM')\n",
    "    axs[0, 0].plot(np.arange(1024), chor[idx, :], color='blue', label='Choroid')\n",
    "    axs[0, 0].set_title(f\"Y Slice\")\n",
    "    axs[0, 0].legend()\n",
    "\n",
    "    annotation_y = ((y >= bm[idx, :]) & (y <= chor[idx, :])).astype(np.uint8)\n",
    "\n",
    "    axs[0, 1].imshow(y_slice, cmap=\"gray\", aspect=\"auto\")\n",
    "    axs[0, 1].imshow(annotation_y, alpha=0.5, aspect=\"auto\")\n",
    "\n",
    "    # plt.show()\n",
    "\n",
    "    # use x slice because optic nerve head in y slice\n",
    "\n",
    "    # IMPORTANT USE FLIP FOR X SLICE BECAUSE ANNOTATIONS ARE FLIPPED IN X DIRECTION, EVEN IF ANA DON'T KNOW WHY, BUT IT'S THE WAY IT IS\n",
    "\n",
    "    axs[1, 0].imshow(x_slice, cmap=\"gray\", aspect=\"auto\")\n",
    "    axs[1, 0].plot(np.arange(1024), bm[:, idx], color='red', label='BM')\n",
    "    axs[1, 0].plot(np.arange(1024), chor[:, idx], color='blue', label='Choroid')\n",
    "    axs[1, 0].set_title(f\"X Slice\")\n",
    "    axs[1, 0].legend()\n",
    "\n",
    "    annotation_x = ((y >= bm[:, idx]) & (y <= chor[:, idx])).astype(np.uint8)\n",
    "\n",
    "    axs[1, 1].imshow(x_slice, cmap=\"gray\", aspect=\"auto\")\n",
    "    axs[1, 1].imshow(annotation_x, alpha=0.5, aspect=\"auto\")\n",
    "\n",
    "    fig.suptitle(f\"Patient: {obs}\")\n",
    "\n",
    "    fig.tight_layout()\n",
    "    plt.show()\n",
    "\n"
=======
    "import os\n",
    "from pathlib import Path\n",
    "def read_combinations(summary_log_path):\n",
    "    combinations_done = set()\n",
    "    if os.path.exists(summary_log_path):\n",
    "        with open(summary_log_path, \"r\", encoding=\"utf-8\") as f:\n",
    "            next(f)  # skip header\n",
    "            for line in f:\n",
    "                parts = line.strip().split(\",\")\n",
    "                if len(parts) < 4:\n",
    "                    continue\n",
    "                arch = parts[0]\n",
    "                encoder = parts[1]\n",
    "                normalization = parts[2]\n",
    "                pretrained = parts[3] if parts[3] != \"scratch\" else None\n",
    "                combinations_done.add((arch, encoder, normalization, pretrained))\n",
    "    return combinations_done\n",
    "\n",
    "\n",
    "log_train_dir = Path(r\"logs/Experiment2and3\")\n",
    "summary_log_path = log_train_dir / \"summary.csv\"\n",
    "combinations_done = read_combinations(summary_log_path)\n",
    "if not os.path.exists(\"logs\"):\n",
    "    os.makedirs(\"logs\")\n",
    "\n",
    "for x in combinations_done:\n",
    "    print(x)"
   ]
